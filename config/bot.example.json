{
  "server": {
    "adapter": "fabric_bridge",
    "connectionMode": "direct",
    "host": "你的域名.com",
    "port": 25565,
    "lanDiscoveryTimeoutMs": 8000,
    "version": "26.2",
    "username": "CialloAI",
    "auth": "offline",
    "connectTimeoutMs": 30000,
    "reconnectDelayMs": 10000,
    "autoRespawn": true,
    "respawnDelayMs": 3000,
    "bridgeHost": "127.0.0.1",
    "bridgePort": 8765,
    "actionTimeoutMs": 10000
  },
  "easyAuth": {
    "enabled": true,
    "registerIfNeeded": true,
    "passwordEnv": "MINECRAFT_LOGIN_PASSWORD",
    "loginDelayMs": 1500
  },
  "model": {
    "provider": "deepseek",
    "model": "deepseek-v4-flash",
    "apiKeyEnv": "DEEPSEEK_API_KEY",
    "baseUrl": "https://api.deepseek.com",
    "reasoningEffort": "high",
    "timeoutMs": 120000,
    "maxOutputTokens": 4096
  },
  "chat": {
    "requireMention": true,
    "replyPrefix": "",
    "cooldownMs": 2500,
    "proactiveEnabled": true,
    "proactiveIdleMs": 180000,
    "proactiveMinIntervalMs": 300000
  },
  "storage": {
    "memoryFile": "data/memory.json",
    "experienceFile": "data/experience.json",
    "maxEvents": 5000
  },
  "policyFile": "config/behavior-rules.json",
  "personaFile": "config/persona.json",
  "promptsFile": "config/prompts.json",
  "logging": {
    "file": "logs/bot.log",
    "level": "info",
    "console": false
  }
}
