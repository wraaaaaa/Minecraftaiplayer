{
  "name": "minecraft-ai-player",
  "version": "1.3.0-alpha",
  "private": true,
  "description": "Headless, API-driven AI player for Minecraft Java Edition",
  "type": "module",
  "main": "electron/main.cjs",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.json --noEmit",
    "dev": "tsx src/index.ts",
    "postinstall": "node scripts/apply-minecraft-data-26.2.mjs",
    "prefetch:minecraft": "node scripts/prefetch-minecraft-libraries.mjs",
    "sync:mods": "node scripts/sync-client-mods.mjs",
    "probe": "tsx src/probe.ts",
    "start": "node dist/src/index.js",
    "start:background": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/start-background.ps1",
    "stop:background": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/stop-background.ps1",
    "start:client": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/start-headless-client.ps1",
    "stop:client": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/stop-headless-client.ps1",
    "start:all": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/start-all-background.ps1",
    "stop:all": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/stop-all-background.ps1",
    "webui": "node dist/src/webui/server.js",
    "start:webui": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/start-webui-background.ps1",
    "stop:webui": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/stop-webui-background.ps1",
    "player-monitor": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/start-player-monitor.ps1",
    "stop:player-monitor": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/stop-player-monitor.ps1",
    "dashboard": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/open-control-center.ps1",
    "audit": "node scripts/audit-repository.mjs",
    "audit:dependencies": "npm audit --omit=dev --registry=https://registry.npmjs.org",
    "test:voice-bridge": "node scripts/test-voice-bridge.mjs --send-test-tone",
    "test": "tsx --test test/**/*.test.ts",
    "desktop": "electron .",
    "dist:desktop": "electron-builder --win"
  },
  "dependencies": {
    "minecraft-data": "3.112.0",
    "mineflayer": "4.37.1",
    "mineflayer-pathfinder": "2.4.5",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@types/node": "24.13.3",
    "@types/ws": "^8.18.1",
    "electron": "^43.4.1",
    "electron-builder": "^26.15.3",
    "tsx": "4.23.5",
    "typescript": "7.0.2"
  },
  "build": {
    "appId": "com.wraaaaaa.minecraftai",
    "productName": "Minecraft AI 总控台",
    "directories": { "output": "dist-e" },
    "files": ["electron/**", "dist/**", "public/webui/**", "config/*.example.json", "config/agent-prompts.example/**", "vendor/minecraft-data/**", "package.json"],
    "win": { "target": "portable" },
    "asar": false
  },
  "overrides": {
    "uuid": "11.1.1"
  }
}
