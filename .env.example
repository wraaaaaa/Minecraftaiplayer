# 复制为 .env 后填写。不要提交 .env。

# EasyAuth 登录密码；只用于发送 /login，不写入日志、记忆或经验文件。
MINECRAFT_LOGIN_PASSWORD=

# 按所选供应商填写一个 API Key。
DEEPSEEK_API_KEY=
ARK_API_KEY=
OPENAI_API_KEY=
MIMO_API_KEY=

# 游戏内语音输出。火山引擎在线 TTS 同时需要 AppID 和 Access Token。
VOLCENGINE_TTS_APP_ID=
VOLCENGINE_TTS_ACCESS_TOKEN=

# 自定义 TTS 可以在 bot.json 的 speech.apiKeyEnv 中引用这个变量。
CUSTOM_TTS_API_KEY=
